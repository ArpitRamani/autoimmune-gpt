# Copy this file to ".env" and fill in the key(s) for the providers you choose.
#
# Two independent choices: who writes the ANSWERS, and who does the EMBEDDINGS.

# --- Answers ---
# "anthropic" (default) or "gemini"
CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# --- Embeddings / retrieval ---
# "local" = on-device, no key, free (default)
# "gemini" = Google text-embedding-004 (needs GEMINI_API_KEY)
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
GEMINI_EMBED_MODEL=text-embedding-004

# Needed if CHAT_PROVIDER=gemini and/or EMBED_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# NOTE: if you switch EMBED_PROVIDER, re-run ingest — the index must be built
# and queried with the same embedder.
